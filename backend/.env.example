DATABASE_URL=postgresql+psycopg2://armsport:armsport@localhost:5432/armsport
# "production" отключает Swagger UI (/docs) на боевом окружении
ENVIRONMENT=development
# Минимум 32 символа, НЕ оставлять значения-заглушки ниже (приложение не стартует)
JWT_SECRET=change-me-in-production
# Токен десктоп-приложения — тоже заменить на сильный случайный
DESKTOP_SYNC_TOKEN=change-me-desktop-sync-token

# Загрузка фото (тренеры/спортсмены) — бесплатный аккаунт на cloudinary.com,
# три значения с дашборда "Product Environment Credentials".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
